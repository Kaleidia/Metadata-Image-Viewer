<Window x:Class="ImageViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#1E1E1E" Foreground="White"
        Title="AI Image Viewer" Height="600" Width="900"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Main Content Area -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch">
            <Button Content="Open Folder" Click="OpenFolder_Click" Foreground="White" Background="#1E1E1E" Margin="5" Padding="5"/>
            <Button Content="Delete" Click="DeleteButton_Click" Margin="5" Foreground="White" Background="#1E1E1E" Padding="5"/>
            <Button Content="Previous" Click="Prev_Click" Foreground="White" Background="#1E1E1E" Margin="5" Padding="5"/>
            <Button Content="Next" Click="Next_Click" Foreground="White" Background="#1E1E1E" Margin="5" Padding="5"/>
            <Button Content="Fit to Area" Click="FitToArea_Click" Foreground="White" Background="#1E1E1E" Margin="5" Padding="5"/>
            <Button Content="1:1 Size" Click="ActualSize_Click" Foreground="White" Background="#1E1E1E" Margin="5" Padding="5"/>
            </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- Image Viewer -->
                <RowDefinition Height="5"/>
                <!-- Splitter -->
                <RowDefinition Height="200"/>
                <!-- Metadata Panel -->
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1E1E1E" Margin="10">
                    <ScrollViewer x:Name="ImageScrollViewer" 
                  HorizontalScrollBarVisibility="Auto" 
                  VerticalScrollBarVisibility="Auto"
                  PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel"
                  MouseLeftButtonDown="ImageScrollViewer_MouseLeftButtonDown"
                  MouseMove="ImageScrollViewer_MouseMove"
                  MouseLeftButtonUp="ImageScrollViewer_MouseLeftButtonUp"
                  Cursor="Hand">
                        <Image Name="MainImage" Stretch="None">
                            <Image.LayoutTransform>
                                <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                            </Image.LayoutTransform>
                        </Image>
                    </ScrollViewer>
            </Border>
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#2D2D30"/>
            <TabControl Grid.Row="2">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Border" Padding="12,6" Margin="0,0,2,0" 
                                Background="#2D2D30" BorderBrush="#333333" BorderThickness="1,1,1,0">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <!-- Active tab matches the background of the text boxes -->
                                            <Setter TargetName="Border" Property="Background" Value="#1E1E1E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="False">
                                            <!-- Inactive tab text color -->
                                            <Setter Property="Foreground" Value="#888888"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <TabItem Header="Metadata">
                    <TextBox Text="{Binding MetadataString, Mode=OneWay}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#1E1E1E" Foreground="White" BorderThickness="0" Padding="5" IsReadOnly="True"/>
                </TabItem>
                <TabItem Header="Comfy Prompt">
                    <TextBox Text="{Binding ComfyString, Mode=OneWay}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#1E1E1E" Foreground="White" BorderThickness="0" Padding="5" IsReadOnly="True"/>
                </TabItem>
                <TabItem Header="Comfy Workflow">
                    <TextBox Text="{Binding WorkflowString, Mode=OneWay}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#1E1E1E" Foreground="White" BorderThickness="0" Padding="5" IsReadOnly="True"/>
                </TabItem>
            </TabControl>
            
        </Grid>
    <StatusBar Grid.Row="2">
            <StatusBarItem Content="{Binding FileCounter, Mode=OneWay}"/>
        </StatusBar>
    </Grid>
</Window>