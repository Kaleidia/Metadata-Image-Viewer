<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#111618"/>
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#E0E6E6"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1B2224"/>
    <SolidColorBrush x:Key="BorderBackgroundBrush" Color="#252F33"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#313D42"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#50C878"/>
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="#3FA260"/>
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="#A3B1B5"/>
    <SolidColorBrush x:Key="UnSelectedForegroundBrush" Color="#313D42"/>
</ResourceDictionary>