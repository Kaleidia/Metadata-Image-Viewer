<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#F1F1F1"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="BorderBackgroundBrush" Color="#3F3F46"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#515155"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#007ACC"/>
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="#1C97EA"/>
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="UnSelectedForegroundBrush" Color="#B0B0B0"/>
</ResourceDictionary>